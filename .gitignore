# ============================================================
# DYNASTY FC — GITIGNORE
# Keep secrets, uploads, logs, and cache out of the repo
# ============================================================

# --- Environment / secrets (NEVER commit real .env) ---
.env
.env.*
*.env

# --- Allow the template (must come LAST to win) ---
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.venv/
venv/
env/
ENV/

# --- Flask / app data ---
instance/
uploads/
*.log
logs/
.flaskenv

# --- Database dumps (contain real data) ---
*.sql
*.sqlite
*.db
*.dump

# --- Editor / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# --- Node ---
node_modules/
npm-debug.log*

# --- Testing ---
.pytest_cache/
.coverage
htmlcov/

# --- Backups ---
*.bak
*.backup
backup/