# ============================================================
# DYNASTY FC — ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
# ============================================================

# --- Flask ---
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=replace-with-a-long-random-string

# --- Database (local) ---
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your-local-mysql-password
DB_NAME=dynasty_integrated_system

# --- Database (production / Render) ---
# DB_HOST=your-prod-host
# DB_USER=your-prod-user
# DB_PASSWORD=your-prod-password
# DB_NAME=your-prod-db
# DB_PORT=3306

# --- SendGrid ---
SENDGRID_API_KEY=SG.replace-with-your-key
SENDGRID_FROM_EMAIL=dynastyfcadmin@gmail.com

# --- Google OAuth ---
GOOGLE_CLIENT_ID=replace-with-client-id
GOOGLE_CLIENT_SECRET=replace-with-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:5001/auth/google/callback